#include <iostream>
#include <random>
#include <vector>
#include <iomanip>
#include <cmath>
#include <chrono>

using namespace std;
using namespace chrono;

int main() {
    setlocale(LC_ALL, "Russian");

    int n = 3;              // Число каналов
    double lambda = 2.0;    // Интенсивность поступления заявок
    double mu = 1.0;        // Интенсивность обслуживания одного канала
    double T = 100000.0;    // Время моделирования

    double rho = lambda / mu;

    mt19937 gen(static_cast<unsigned>(steady_clock::now().time_since_epoch().count()));
    exponential_distribution<double> arrivalGen(lambda);
    exponential_distribution<double> serviceGen(mu);

    // Время окончания обслуживания в каждом канале.
    // 0 означает, что канал свободен.
    vector<double> finish(n, 0.0);

    double t = 0.0;
    int total = 0;
    int rejected = 0;
    int accepted = 0;

    while (true) {
        t += arrivalGen(gen);

        if (t > T)
            break;

        total++;

        // Освобождаем каналы, обслуживание в которых завершилось.
        for (int i = 0; i < n; i++) {
            if (finish[i] <= t)
                finish[i] = 0.0;
        }

        // Ищем свободный канал.
        int freeChannel = -1;

        for (int i = 0; i < n; i++) {
            if (finish[i] == 0.0) {
                freeChannel = i;
                break;
            }
        }

        if (freeChannel != -1) {
            // Заявка принята на обслуживание.
            finish[freeChannel] = t + serviceGen(gen);
            accepted++;
        }
        else {
            // Все каналы заняты — отказ.
            rejected++;
        }
    }

    // Теоретическая вероятность отказа по Эрлангу B.
    double denominator = 1.0;
    double term = 1.0;

    for (int k = 1; k <= n; k++) {
        term *= rho / k;
        denominator += term;
    }

    double termN = 1.0;
    for (int k = 1; k <= n; k++)
        termN *= rho / k;

    double pReject = termN / denominator;
    double theoreticalRejects = lambda * T * pReject;

    cout << fixed << setprecision(4);
    cout << "Число каналов n: " << n << "\n";
    cout << "Интенсивность заявок lambda: " << lambda << "\n";
    cout << "Интенсивность обслуживания mu: " << mu << "\n";
    cout << "Нагрузка rho = lambda / mu: " << rho << "\n\n";

    cout << "Всего поступило заявок: " << total << "\n";
    cout << "Принято заявок: " << accepted << "\n";
    cout << "Отказов: " << rejected << "\n";
    cout << "Доля отказов: "
        << (total > 0 ? (double)rejected / total : 0.0) << "\n";
    cout << "Отказов за единицу времени: "
        << (double)rejected / T << "\n\n";

    cout << "Теоретическая вероятность отказа: "
        << pReject << "\n";
    cout << "Теоретическое среднее число отказов за T: "
        << theoreticalRejects << "\n";

    return 0;
}

