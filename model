        bernoulli_distribution keep(p);

        cout << "\n========== p = " << p << " ==========\n";

        // --- 1) РАЗРЕЖЕНИЕ РАВНОМЕРНОГО ПОТОКА ---
        vector<double> arrival;
        double t = 0;
        for (int i = 0; i < total; ++i) {
            t += h_step;
