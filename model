#include <iostream>
#include <random>
#include <chrono>
#include <vector>
#include <cmath>
#include <map>
#include <iomanip>

using namespace std;

// Считает Fano factor для потока
void analyze(const vector<double>& arrival, int n1) {
    int m = arrival.size();
    if (m < 2) return;

    double lastTime = arrival.back();
    double h = lastTime / n1;

    vector<int> eventsInInterval(n1, 0);
    int idx = 0;
    double hi = 0;

    for (int i = 0; i < n1; ++i) {
        hi += h;
        while (idx < m && arrival[idx] < hi) {
            eventsInInterval[i]++;
            idx++;
        }
    }

    // Гистограмма
    map<int, int> hist;
    for (int c : eventsInInterval) hist[c]++;

    cout << "  Гистограмма числа событий в окне:\n";
    for (auto& kv : hist) {
        cout << "    " << kv.first << " событий: "
            << (double)kv.second / n1 << "\n";
    }

    // Fano factor
    double meanCount = 0, varCount = 0;
    for (int c : eventsInInterval) meanCount += c;
    meanCount /= n1;
    for (int c : eventsInInterval) varCount += (c - meanCount) * (c - meanCount);
    varCount /= n1;

    double fano = varCount / meanCount;

    cout << "  Среднее число событий: " << meanCount << "\n";
    cout << "  Дисперсия:             " << varCount << "\n";
    cout << "  Fano factor:           " << fano
        << "   (для Пуассона = 1)\n";
}

