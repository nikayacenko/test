#include <iostream>
#include <random>
#include <chrono>
#include <vector>
#include <queue>
#include <array>
#include <iomanip>
#include <limits>

using namespace std;
using namespace chrono;


struct Job {
    double arrival;
    int k, m, l;
    int done1 = 0, done2 = 0, done3 = 0;
};

int main() {
    setlocale(LC_ALL, "Russian");

    mt19937 mt(static_cast<unsigned>(steady_clock::now().time_since_epoch().count()));

    const int n = 100000;

    // Интенсивности обслуживания
    double mu1 = 0.5, mu2 = 0.5, mu3 = 0.5;

    uniform_real_distribution<> tau(4, 6);
    uniform_int_distribution<> km(1, 2);
    uniform_int_distribution<> ld(0, 2);
    exponential_distribution<> s1(mu1), s2(mu2), s3(mu3);

    vector<Job> jobs;
    jobs.reserve(n);

    array<queue<int>, 3> q;
    array<int, 3> current = { -1, -1, -1 };
    array<double, 3> finish = {
        numeric_limits<double>::infinity(),
        numeric_limits<double>::infinity(),
        numeric_limits<double>::infinity()
    };

    int generated = 0, completed = 0;
    double t = 0, nextArrival = tau(mt);
    double totalTime = 0;

    // Запуск обслуживания на свободной фазе
    auto start = [&](int phase) {
        if (current[phase] != -1 || q[phase].empty())
            return;

        int id = q[phase].front();
        q[phase].pop();
        current[phase] = id;

        if (phase == 0) finish[phase] = t + s1(mt);
        if (phase == 1) finish[phase] = t + s2(mt);
        if (phase == 2) finish[phase] = t + s3(mt);
        };

    while (completed < n) {
        // Ближайшее событие
        t = nextArrival;
        for (int i = 0; i < 3; ++i)
            t = min(t, finish[i]);

        // Завершение обслуживания
        for (int i = 0; i < 3; ++i) {
            if (current[i] == -1 || finish[i] > t)
                continue;

            int id = current[i];
            current[i] = -1;
            finish[i] = numeric_limits<double>::infinity();

            Job& j = jobs[id];

            if (i == 0) {
                ++j.done1;
                if (j.done1 < j.k)
                    q[0].push(id);
                else
                    q[1].push(id);
            }
            else if (i == 1) {
                ++j.done2;
                if (j.done2 < j.m)
                    q[1].push(id);
                else if (j.l > 0)
                    q[2].push(id);
                else {
                    totalTime += t - j.arrival;
                    ++completed;
                }
            }
            else {
                ++j.done3;
                if (j.done3 < j.l)
                    q[2].push(id);
                else {
                    totalTime += t - j.arrival;
                    ++completed;
                }
            }
        }

        // Поступление нового задания
        if (generated < n && nextArrival <= t) {
            Job j;
            j.arrival = t;
            j.k = km(mt);
            j.m = km(mt);
            j.l = ld(mt);

            jobs.push_back(j);
            q[0].push(generated);
            ++generated;

            if (generated < n)
                nextArrival = t + tau(mt);
            else
                nextArrival = numeric_limits<double>::infinity();
        }

        // Запускаем свободные фазы
        for (int i = 0; i < 3; ++i)
            start(i);
    }

    double lambda = 1.0 / 5.0;

    cout << fixed << setprecision(4);
    cout << "Поступило заданий: " << generated << '\n';
    cout << "Завершено заданий: " << completed << '\n';

    cout << "\nКоэффициенты загрузки:\n";
    cout << "rho1 = " << lambda * 1.5 / mu1 << '\n';
    cout << "rho2 = " << lambda * 1.5 / mu2 << '\n';
    cout << "rho3 = " << lambda * 1.0 / mu3 << '\n';

    cout << "\nУсловия устойчивости:\n";
    cout << "mu1 > 0.3: " << (mu1 > 0.3 ? "да" : "нет") << '\n';
    cout << "mu2 > 0.3: " << (mu2 > 0.3 ? "да" : "нет") << '\n';
    cout << "mu3 > 0.2: " << (mu3 > 0.2 ? "да" : "нет") << '\n';

    cout << "\nСреднее время пребывания в системе: "
        << totalTime / completed << '\n';

    return 0;
}


